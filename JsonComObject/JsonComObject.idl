// This file will be processed by the MIDL tool to
// produce the type library (JsonComObject.tlb) and marshalling code.

import "oaidl.idl";
import "ocidl.idl";

[
    uuid(E1603BED-3CF1-47A1-9645-C4B29BFB464F),
    version(1.0),
]
library JsonComObjectLib
{
    importlib("stdole2.tlb");

    [
        uuid(5209FCEF-4C08-4C84-8A8F-9E7D198663AA),
        object, oleautomation, dual,
    ] 
    interface IJsonParser : IDispatch
    {
        HRESULT ParseJson([in] BSTR json, [out, retval] VARIANT *result);
    };

    [
        uuid(DE019FE6-BF16-49EB-852D-9EFB239350C0),
        version(1.0), helpstring("JSON Parser Object 1.0"),
    ]
    coclass JsonParser
    {
        [default] interface IJsonParser;
        interface IDispatch;
    };
};
