<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap7="http://schemas.microsoft.com/appx/manifest/uap/windows10/7"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:com2="http://schemas.microsoft.com/appx/manifest/com/windows10/2"
  xmlns:com4="http://schemas.microsoft.com/appx/manifest/com/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="85f82862-80db-4713-801a-fa1d48c576f9"
    Publisher="CN=kazssym"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>JsonComObject</DisplayName>
    <PublisherDisplayName>Kaz Nishimura</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.20348.0" MaxVersionTested="10.0.22000.0"/>
  </Dependencies>
  
  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>JsonComObject.dll</Path>
        <ActivatableClass ActivatableClassId="JsonComObject" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
    <com4:Extension Category="windows.comServer">
      <com4:ComServer>
        <com4:InProcessServer>
          <com4:Class
            Id="DE019FE6-BF16-49EB-852D-9EFB239350C0"
            ThreadingModel="Both"
            ProgId="JsonComObject.JsonParser.1"
            VersionIndependentProgId="JsonComObject.JsonParser" />
        </com4:InProcessServer>
        <com4:ProgId
          Id="JsonComObject.JsonParser"
          CurrentVersion="JsonComObject.JsonParser.1" />
        <com4:ProgId
          Id="JsonComObject.JsonParser.1"
          Clsid="DE019FE6-BF16-49EB-852D-9EFB239350C0" />
      </com4:ComServer>
    </com4:Extension>
  </Extensions>
</Package>
