# EditorConfig: https://editorconfig.org

root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true

[*.{xml,props,targets,slnx,vcxproj,filters}]
indent_style = space
indent_size = 2
end_of_line = crlf
insert_final_newline = false

[*.json]
indent_style = space
indent_size = 2
insert_final_newline = false
